# Expo client (public, bundled into the app)
# Run `npm run convex` from the repo root, then copy the deployment URL here.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk Dashboard > API keys > Publishable key. Never put a secret key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# On the Convex deployment (not in the Expo bundle):
#   npm run backend -- env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# Copy this URL from Clerk's Convex integration page.

# Convex server-side secrets. Set these on the Convex deployment, not here:
#   npm run backend -- env set TYPESAFE_API_KEY YOUR_TYPESAFE_API_KEY
# Create the key in your TypeSafe AI account. Never use an EXPO_PUBLIC_ prefix for it.
# TYPESAFE_API_KEY=
