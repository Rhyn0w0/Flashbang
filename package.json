{
  "name": "flashbang",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace @flashbang/frontend --",
    "android": "npm run android --workspace @flashbang/frontend --",
    "ios": "npm run ios --workspace @flashbang/frontend --",
    "web": "npm run web --workspace @flashbang/frontend --",
    "build:web": "npm run build:web --workspace @flashbang/frontend --",
    "convex": "npm run dev --workspace @flashbang/backend --",
    "backend": "npm exec --workspace @flashbang/backend -- convex",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:auth": "node scripts/verify-clerk.mjs",
    "seed:profiles": "npm run backend -- run seed:profilesForTesting",
    "check:structure": "node scripts/check-structure.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  }
}
